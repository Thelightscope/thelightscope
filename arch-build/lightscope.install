# LightScope Arch Linux install script

print_status() {
    echo ":: $(date '+%F %T') - $1"
}

post_install() {
    print_status "Setting up LightScope..."

    # Create lightscope user if it doesn't exist
    if ! id -u lightscope >/dev/null 2>&1; then
        print_status "Creating lightscope system user..."
        useradd --system --home /opt/lightscope --create-home --shell /usr/bin/nologin lightscope
    else
        print_status "lightscope user already exists"
    fi

    # Set up directory structure and permissions
    mkdir -p /opt/lightscope/{bin,venv,logs,config,updates}
    chown -R lightscope:lightscope /opt/lightscope

    # Create Python virtual environment
    print_status "Setting up Python virtual environment..."
    python -m venv --system-site-packages /opt/lightscope/venv
    chown -R lightscope:lightscope /opt/lightscope/venv

    # Install Python dependencies in venv
    print_status "Installing Python dependencies..."
    /opt/lightscope/venv/bin/pip install --upgrade pip
    /opt/lightscope/venv/bin/pip install dpkt psutil requests python-libpcap packaging

    # Install systemd-python with error handling
    print_status "Installing systemd-python for watchdog support..."
    if /opt/lightscope/venv/bin/pip install systemd-python; then
        print_status "systemd-python installed successfully"
    else
        print_status "Warning: systemd-python installation failed. Watchdog notifications will be disabled."
    fi

    # Generate unique database name during installation
    print_status "Generating unique database name..."
    TODAY=$(date +%Y%m%d)

    # Check if GreyNoise mode is enabled
    if [ -f "/tmp/.greynoise" ] || [ -f "/opt/lightscope/.greynoise" ] || [ -f "$HOME/.greynoise" ] || \
       [ -f "/home/*/.greynoise" ] || [ -f "/root/.greynoise" ]; then
        print_status "GreyNoise mode detected - using 'gn' prefix for database name"
        RAND_PART=$(cat /dev/urandom | tr -dc 'a-z' | head -c 45)
        DB_NAME="gn${TODAY}_${RAND_PART}"
    else
        RAND_PART=$(cat /dev/urandom | tr -dc 'a-z' | head -c 47)
        DB_NAME="${TODAY}_${RAND_PART}"
    fi
    print_status "Generated database name: $DB_NAME"

    # Clean up old config file location if it exists
    if [ -f "/opt/lightscope/config/config.ini" ]; then
        rm -f /opt/lightscope/config/config.ini
    fi

    # Create configuration file with pre-populated database name
    if [ ! -f "/opt/lightscope/config.ini" ]; then
        print_status "Creating configuration file with database name: $DB_NAME"
        cat > /opt/lightscope/config.ini << EOF
[Settings]
# Database name for storing LightScope data (auto-generated during installation)
database = $DB_NAME

# Randomization key for IP address anonymization (auto-generated if empty)
randomization_key =

# Enable automatic SSH/Telnet honeypot port forwarding (yes/no)
self_telnet_and_ssh_honeypot_ports_to_forward = no

# Enable automatic updates (yes/no)
autoupdate = yes

# Update check interval in hours (minimum 1 hour)
update_check_interval = 24

# Enable debug logging (yes/no)
debug_logging = no

# Custom interface to monitor (leave empty for auto-detection)
interface =

# Maximum number of concurrent honeypot ports
max_honeypot_ports = 10

# Honeypot rotation interval in hours
honeypot_rotation_interval = 4
EOF
        chown lightscope:lightscope /opt/lightscope/config.ini
        chmod 644 /opt/lightscope/config.ini
    else
        print_status "Configuration file already exists, updating database name..."
        python << EOF
import configparser

config_file = "/opt/lightscope/config.ini"
db_name = "$DB_NAME"

try:
    config = configparser.ConfigParser()
    config.read(config_file)

    if not config.has_section('Settings'):
        config.add_section('Settings')

    config.set('Settings', 'database', db_name)

    with open(config_file, 'w') as f:
        config.write(f)

    print(f"Updated config file with database name: {db_name}")
except Exception as e:
    print(f"Error updating config file: {e}")
EOF
    fi

    # Update systemd service with database name environment variable
    print_status "Configuring systemd service with database name..."
    mkdir -p /etc/systemd/system/lightscope.service.d
    cat > /etc/systemd/system/lightscope.service.d/database-name.conf << EOF
# LightScope Database Name Override
# This file is automatically generated during installation
[Unit]
Documentation=https://thelightscope.com https://thelightscope.com/light_table/$DB_NAME

[Service]
Environment=LIGHTSCOPE_DB_NAME=$DB_NAME
EOF
    chmod 644 /etc/systemd/system/lightscope.service.d/database-name.conf

    # Set proper permissions
    chmod 755 /opt/lightscope/bin/lightscope-runner.py
    chmod 644 /opt/lightscope/config.ini
    chmod 755 /opt/lightscope/updates

    # Reload systemd and enable service
    print_status "Enabling and starting LightScope service..."
    systemctl daemon-reload
    systemctl enable lightscope
    systemctl start lightscope

    echo ""
    echo "=============================================="
    echo "LIGHTSCOPE DASHBOARD ACCESS"
    echo "=============================================="
    echo "Database Name: $DB_NAME"
    echo "Dashboard URL: https://lightscope.isi.edu/light_table/$DB_NAME"
    echo "Web Interface: https://lightscope.isi.edu/light_table"
    echo ""
    echo "To find your database name later:"
    echo "   sudo systemctl status lightscope"
    echo "   (Look for LIGHTSCOPE_DB_NAME in the environment)"
    echo ""
    echo "=============================================="
    echo ""
    echo "Configuration file: /opt/lightscope/config.ini"
    echo "Log files: /opt/lightscope/logs/"
    echo ""
    echo "LightScope service is now running!"
    echo "To check status: sudo systemctl status lightscope"
    echo "To view logs: sudo journalctl -u lightscope -f"
    echo "To restart: sudo systemctl restart lightscope"
    echo "To stop: sudo systemctl stop lightscope"
}

post_upgrade() {
    print_status "Upgrading LightScope..."

    # Update venv dependencies
    print_status "Updating Python dependencies..."
    /opt/lightscope/venv/bin/pip install --upgrade pip
    /opt/lightscope/venv/bin/pip install --upgrade dpkt psutil requests python-libpcap packaging

    # Reload and restart service
    print_status "Restarting LightScope service..."
    systemctl daemon-reload
    systemctl restart lightscope

    print_status "LightScope upgrade completed!"
}

pre_remove() {
    print_status "Stopping LightScope service..."
    systemctl stop lightscope || true
    systemctl disable lightscope || true
}

post_remove() {
    print_status "Cleaning up LightScope..."
    systemctl daemon-reload || true

    echo ""
    echo "LightScope has been removed."
    echo "Configuration files in /opt/lightscope/ have been preserved."
    echo "To completely remove all data, run: sudo rm -rf /opt/lightscope"
    echo "To remove the lightscope user: sudo userdel lightscope"
}
