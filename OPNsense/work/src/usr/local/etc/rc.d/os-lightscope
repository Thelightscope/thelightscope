#!/bin/sh
#
# PROVIDE: lightscope
# REQUIRE: DAEMON
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable lightscope:
#
# lightscope_enable="YES"
#

. /etc/rc.subr

name="lightscope"
rcvar="${name}_enable"

load_rc_config $name

: ${lightscope_enable:="NO"}
: ${lightscope_config:="/usr/local/etc/lightscope.conf"}

pidfile="/var/run/${name}.pid"
command="/usr/local/bin/python3"
command_args="/usr/local/opnsense/scripts/lightscope/lightscope_daemon.py"
command_interpreter="/usr/local/bin/python3"

start_precmd="${name}_prestart"
stop_postcmd="${name}_poststop"

lightscope_prestart()
{
    # Copy sample config if no config exists
    if [ ! -f "${lightscope_config}" ]; then
        if [ -f "${lightscope_config}.sample" ]; then
            cp "${lightscope_config}.sample" "${lightscope_config}"
            echo "Created ${lightscope_config} from sample"
        fi
    fi

    # Ensure pflog0 interface exists
    if ! ifconfig pflog0 > /dev/null 2>&1; then
        echo "Warning: pflog0 interface not found. Creating..."
        ifconfig pflog0 create
    fi

    return 0
}

lightscope_poststop()
{
    # Clean up pid file
    rm -f ${pidfile}
    return 0
}

run_rc_command "$1"
